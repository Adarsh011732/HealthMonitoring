{
  "name": "smart-health-monitor",
  "version": "1.0.0",
  "description": "Smart Deployment Health Monitor Service with CI/CD and Terraform",
  "main": "src/app/server.js",
  "scripts": {
    "db:setup": "node scripts/setup-mongodb.mjs",
    "monitor:pipelines": "node --env-file=.env.local scripts/pipeline-monitor.mjs",
    "start": "next start --hostname 0.0.0.0 -p 3001",
    "dev": "next dev --hostname 0.0.0.0 -p 3001",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "start:legacy": "node src/app/server.js",
    "test": "node --test tests/**/*.test.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.26",
    "better-auth": "^1.7.26",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "lucide-react": "^1.75.0",
    "mongodb": "^7.9.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  }
}
