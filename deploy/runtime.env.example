# Copy to runtime.env ON THE SERVER and chmod 600. Never commit real values.
# Optional, read-only public GitHub API access. Never NEXT_PUBLIC_.
GITHUB_TOKEN=
# Optional: monitor sends failure/recovery transitions only.
DISCORD_WEBHOOK_URL=
# Gmail SMTP for the single-owner monitor. Use a Google App Password.
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=
MONGODB_URI=
MONGODB_DB=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
