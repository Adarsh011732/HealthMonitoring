# Smart Deployment Health Monitor Environment Configuration Template
# Duplicate this file to .env.local and populate with your credentials.

# Local server port
PORT=3001

# Better Auth Configuration
BETTER_AUTH_SECRET=your_32_character_random_hex_secret_here
BETTER_AUTH_URL=http://localhost:3001

# MongoDB Atlas URI and database name
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/
MONGODB_DB=BranchLineMonitor

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Google OAuth Credentials (Optional)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# Alert Email Configuration (Nodemailer / SMTP)
SMTP_USER=developer@example.com
SMTP_APP_PASSWORD=your_16_character_app_password
ALERT_EMAIL_TO=alerts@example.com

# Optional server-only GitHub token for private repositories
# GITHUB_TOKEN=ghp_your_token_here

# Docker Hub Credentials (used in CI/CD pipeline)
# DOCKERHUB_USER=your_dockerhub_username
# DOCKERHUB_TOKEN=your_dockerhub_pat_token
